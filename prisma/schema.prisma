generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator dbml {
  provider            = "prisma-dbml-generator"
  outputName          = "ibivibe_er.dbml"
  projectDatabaseType = "PostgreSQL"
  projectName         = "IbiVibeDB"
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model account_oauth {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id   String         @db.Uuid
  provider     oauth_provider
  provider_uid String         @db.VarChar(255)
  email        String         @db.VarChar(255)
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  updated_at   DateTime       @updatedAt @db.Timestamp(6)
  account      account        @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_uid])
  @@unique([provider, email])
  @@index([account_id])
}

model account {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String               @unique @db.VarChar(255)
  password            String?              @db.VarChar(255)
  phone_number        String?              @unique @db.VarChar(20)
  slug                String?              @unique @db.VarChar(100)
  display_name        String               @db.VarChar(150)
  bio                 String?
  avatar_url          String?
  gender              gender?
  type                account_type         @default(personal)
  role                account_role         @default(user)
  name                String               @db.VarChar(50)
  active              Boolean              @default(true)
  is_verified         Boolean              @default(false)
  created_at          DateTime             @default(now()) @db.Timestamp(6)
  updated_at          DateTime             @updatedAt @db.Timestamp(6)
  favorites           account_favorite[]   @relation("AccountFavorites")
  interests           account_interest[]
  business            business?
  events              event[]              @relation("AccountEvents")
  medias              media[]              @relation("AccountMedias")
  verification_tokens verification_token[]
  reviews             review[]             @relation("AccountReviews")
  oauth_accounts      account_oauth[]
}

model verification_token {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token      String     @unique @db.VarChar(255)
  account_id String     @db.Uuid
  type       token_type
  expires_at DateTime   @db.Timestamp(6)
  used_at    DateTime?  @db.Timestamp(6)
  created_at DateTime   @default(now()) @db.Timestamp(6)
  account    account    @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
}

model business {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_account_id  String                    @unique @db.Uuid
  commercial_name   String?                   @db.VarChar(150)
  profile_photo_url String?
  description       String?
  cnpj              String?                   @db.VarChar(20)
  max_reach_level   reach_level               @default(local)
  is_verified       Boolean                   @default(false)
  verified_at       DateTime?                 @db.Timestamp(6)
  accepts_payment   Boolean                   @default(false)
  offers_delivery   Boolean                   @default(false)
  in_person_service Boolean                   @default(true)
  accessibility     Boolean                   @default(false)
  parking           Boolean                   @default(false)
  wifi              Boolean                   @default(false)
  created_at        DateTime                  @default(now()) @db.Timestamp(6)
  updated_at        DateTime                  @updatedAt @db.Timestamp(6)
  favorites         account_favorite[]
  account           account                   @relation(fields: [owner_account_id], references: [id], onDelete: Cascade)
  tags              business_tag[]
  cities            business_city[]
  social_links      business_social_links?
  hours             business_hours[]
  hour_exceptions   business_hour_exception[]
  services          business_service[]
  medias            media[]                   @relation("BusinessMedias")
  reviews           review[]                  @relation("BusinessReviews")

  @@index([owner_account_id])
}

model city {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String                  @unique
  name          String
  description   String?
  location      Unsupported("geometry")
  created_at    DateTime                @default(now())
  updated_at    DateTime                @updatedAt
  favorites     account_favorite[]
  businesses    business_city[]
  tags          city_tag[]
  events        event_city[]
  medias        media[]                 @relation("CityMedias")

  @@index([location], type: Gist)
}

model event {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String             @unique @db.VarChar(100)
  owner_account_id String             @db.Uuid
  name             String             @db.VarChar(200)
  description      String?
  reach_level      reach_level
  type             event_type         @default(simple)
  start_date       DateTime
  end_date         DateTime
  active           Boolean            @default(true)
  status           event_status       @default(published)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @updatedAt @db.Timestamp(6)
  favorites        account_favorite[]
  owner            account            @relation("AccountEvents", fields: [owner_account_id], references: [id], onDelete: Cascade)
  tags             event_tag[]
  cities           event_city[]
  medias           media[]            @relation("EventMedias")
  reviews          review[]           @relation("EventReviews")

  @@index([owner_account_id])
}

model media {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id    String?    @db.Uuid
  city_id       String?    @db.Uuid
  event_id      String?    @db.Uuid
  business_id   String?    @db.Uuid
  media_type    media_type
  url           String
  thumbnail_url String?
  is_cover      Boolean    @default(false)
  position      Int        @default(0)
  alt_text      String?
  created_at    DateTime   @default(now())
  account       account?   @relation("AccountMedias", fields: [account_id], references: [id], onDelete: Cascade)
  city          city?      @relation("CityMedias", fields: [city_id], references: [id], onDelete: Cascade)
  event         event?     @relation("EventMedias", fields: [event_id], references: [id], onDelete: Cascade)
  business      business?  @relation("BusinessMedias", fields: [business_id], references: [id], onDelete: Cascade)
}

model account_favorite {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id  String    @db.Uuid
  city_id     String?   @db.Uuid
  event_id    String?   @db.Uuid
  business_id String?   @db.Uuid
  account     account   @relation("AccountFavorites", fields: [account_id], references: [id], onDelete: Cascade)
  business    business? @relation(fields: [business_id], references: [id], onDelete: Cascade)
  city        city?     @relation(fields: [city_id], references: [id], onDelete: Cascade)
  event       event?    @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([account_id, city_id])
  @@unique([account_id, event_id])
  @@unique([account_id, business_id])
  @@index([account_id])
}

model account_interest {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id String  @db.Uuid
  tag_id     String  @db.Uuid
  account    account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  tag        tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([account_id, tag_id])
}

model tag_group {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)
  tags        tag[]
}

model tag {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String             @unique
  description String?
  color       String?            @db.VarChar(7)
  group_id    String             @db.Uuid
  position    Int                @default(0)
  created_at  DateTime           @default(now()) @db.Timestamp(6)
  updated_at  DateTime           @updatedAt @db.Timestamp(6)
  group       tag_group          @relation(fields: [group_id], references: [id], onDelete: Cascade)
  businesses  business_tag[]
  events      event_tag[]
  cities      city_tag[]
  interests   account_interest[]
  targets     tag_target[]

  @@unique([group_id, name])
  @@index([group_id])
  @@index([slug])
}

enum tag_target_type {
  city
  business
  event
}

model tag_target {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tag_id      String          @db.Uuid
  target_type tag_target_type
  tag         tag             @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([tag_id, target_type])
  @@index([target_type])
}

model city_tag {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id String @db.Uuid
  tag_id  String @db.Uuid
  tag     tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  city    city   @relation(fields: [city_id], references: [id], onDelete: Cascade)

  @@unique([city_id, tag_id])
}

model business_tag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String   @db.Uuid
  tag_id      String   @db.Uuid
  business    business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  tag         tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([business_id, tag_id])
}

model business_city {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String                    @db.Uuid
  city_id          String                    @db.Uuid
  is_headquarter   Boolean                   @default(false)
  address_specific String?
  address          String?
  neighborhood     String?
  postal_code      String?                   @db.VarChar(20)
  latitude         Float?
  longitude        Float?
  map_url          String?
  business         business                  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  city             city                      @relation(fields: [city_id], references: [id], onDelete: Cascade)
  hours            business_hours[]
  hour_exceptions  business_hour_exception[]

  @@unique([business_id, city_id])
  @@index([business_id, is_headquarter])
}

model business_social_links {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id  String   @unique @db.Uuid
  phone        String?  @db.VarChar(30)
  whatsapp     String?  @db.VarChar(30)
  public_email String?  @db.VarChar(255)
  website      String?
  instagram    String?
  facebook     String?
  business     business @relation(fields: [business_id], references: [id], onDelete: Cascade)
}

model business_hours {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String         @db.Uuid
  business_city_id String?        @db.Uuid
  weekday          Int            @db.SmallInt
  is_closed        Boolean        @default(false)
  opens_at         String?        @db.VarChar(5)
  closes_at        String?        @db.VarChar(5)
  break_start      String?        @db.VarChar(5)
  break_end        String?        @db.VarChar(5)
  business         business       @relation(fields: [business_id], references: [id], onDelete: Cascade)
  location         business_city? @relation(fields: [business_city_id], references: [id], onDelete: Cascade)

  @@unique([business_id, business_city_id, weekday])
  @@index([business_id])
}

model business_hour_exception {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String         @db.Uuid
  business_city_id String?        @db.Uuid
  date             DateTime       @db.Date
  is_closed        Boolean        @default(true)
  opens_at         String?        @db.VarChar(5)
  closes_at        String?        @db.VarChar(5)
  reason           String?
  business         business       @relation(fields: [business_id], references: [id], onDelete: Cascade)
  location         business_city? @relation(fields: [business_city_id], references: [id], onDelete: Cascade)

  @@unique([business_id, business_city_id, date])
  @@index([business_id, date])
}

model business_service {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id  String   @db.Uuid
  name         String   @db.VarChar(150)
  description  String?
  price_from   Decimal? @db.Decimal(12, 2)
  price_to     Decimal? @db.Decimal(12, 2)
  price_label  String?  @db.VarChar(100)
  booking_url  String?
  service_type String?  @db.VarChar(50)
  position     Int      @default(0)
  active       Boolean  @default(true)
  business     business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, active, position])
}

model event_tag {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id String @db.Uuid
  tag_id   String @db.Uuid
  event    event  @relation(fields: [event_id], references: [id], onDelete: Cascade)
  tag      tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([event_id, tag_id])
}

model event_city {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id         String  @db.Uuid
  city_id          String  @db.Uuid
  address_specific String? @db.VarChar
  city             city    @relation(fields: [city_id], references: [id], onDelete: Cascade)
  event            event   @relation(fields: [event_id], references: [id], onDelete: Cascade)
}

model lead {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(50)
  email         String    @unique @db.VarChar(100)
  phone_number  String    @unique @db.VarChar(20)
  type          lead_type
  business_name String?   @db.VarChar(50)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt @db.Timestamp(6)
}

model review {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id  String   @db.Uuid
  business_id String?  @db.Uuid
  event_id    String?  @db.Uuid
  rating      Int      @db.SmallInt
  comment     String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  account  account   @relation("AccountReviews", fields: [account_id], references: [id], onDelete: Cascade)
  business business? @relation("BusinessReviews", fields: [business_id], references: [id], onDelete: Cascade)
  event    event?    @relation("EventReviews", fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([account_id, business_id])
  @@unique([account_id, event_id])
  @@index([business_id])
  @@index([event_id])
  @@index([business_id, rating])
  @@index([event_id, rating])
  @@index([created_at])
}

enum lead_type {
  resident
  tourist
  business
}

enum oauth_provider {
  google
}

enum account_type {
  personal
  business
}

enum account_role {
  user
  admin
  super_admin
}

enum gender {
  male
  female
  non_binary
  prefer_not_to_say
}

enum reach_level {
  local
  regional
}

enum event_type {
  simple
  featured
}

enum event_status {
  published
  draft
}

enum media_type {
  image
  video
}

enum token_type {
  verify_email
  reset_password
}
