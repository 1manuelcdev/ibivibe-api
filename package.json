{
	"name": "ibivibe-api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "MIT",
	"scripts": {
		"postinstall": "prisma generate",
		"build": "nest build && tsc-alias",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:prod": "node dist/src/main",
		"docker:up": "bash scripts/docker-up.sh",
		"docker:down": "bash scripts/docker-down.sh",
		"ngrok:up": "bash scripts/ngrok-up.sh",
		"ngrok:down": "bash scripts/ngrok-down.sh",
		"db:migrate": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:studio": "prisma studio",
		"db:seed": "prisma migrate deploy && tsx prisma/seed.ts",
		"test:unit": "dotenv -e .env.test -- sh -c 'jest'",
		"test:unit:watch": "dotenv -e .env.test -- sh -c 'jest --watch'",
		"test:unit:cov": "dotenv -e .env.test -- sh -c 'jest --coverage'",
		"test:e2e": "dotenv -e .env.test -- sh -c 'prisma generate && prisma migrate deploy && jest --config ./test/jest-e2e.json --runInBand'",
		"test:all": "pnpm test:unit && pnpm test:e2e"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1003.0",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.1",
		"@nestjs/mapped-types": "*",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/swagger": "^11.2.6",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/serve-static": "^5.0.5",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^7.8.0",
		"argon2": "^0.44.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"cookie-parser": "^1.4.7",
		"google-auth-library": "^10.6.2",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.1.1",
		"pg": "^8.20.0",
		"picocolors": "^1.1.1",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.12.2",
		"rxjs": "^7.8.1",
		"sharp": "^0.35.4",
		"swagger-ui-express": "^5.0.1",
		"tsx": "^4.21.0",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.0.0",
		"@types/node": "^22.10.7",
		"@types/pg": "^8.18.0",
		"@types/supertest": "^6.0.2",
		"dotenv": "^17.2.3",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^16.0.0",
		"jest": "^30.3.0",
		"jest-mock-extended": "^4.0.0",
		"oxfmt": "^0.43.0",
		"oxlint": "^1.58.0",
		"prettier": "^3.4.2",
		"prisma": "^7.8.0",
		"prisma-dbml-generator": "^0.12.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.4.9",
		"ts-loader": "^9.5.2",
		"tsc-alias": "^1.8.16",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	}
}
